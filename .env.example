# 复制为 .env.local 后，使用：docker compose --env-file .env.local up -d --build
# 应用私钥只保存在该文件，.env.local 已被 Git 忽略，禁止提交。
ORDERFLOW_ALIPAY_ENABLED=true
ORDERFLOW_ALIPAY_APP_ID=9021000167606334
ORDERFLOW_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ORDERFLOW_ALIPAY_APP_PRIVATE_KEY=在这里填写沙箱应用私钥（单行，不带 BEGIN/END 标记）
ORDERFLOW_ALIPAY_PUBLIC_KEY=在这里填写沙箱支付宝公钥
# 内网穿透得到公网 HTTPS 地址后再填写；必须能访问到本机 8088 端口。
ORDERFLOW_ALIPAY_NOTIFY_URL=https://your-public-domain.example/api/payments/alipay/notify
# 填 HTTPS 公网地址；若保留 localhost，后端会自动复用上方 HTTPS 公网地址。
ORDERFLOW_ALIPAY_RETURN_URL=https://your-public-domain.example/#/shop/orders
